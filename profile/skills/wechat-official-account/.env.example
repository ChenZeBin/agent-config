# pair: only record the sender HMAC; run: accept that one sender and execute intake + LLM Wiki.
WECHAT_MODE=pair
WECHAT_TOKEN=ReplaceWechatToken123
WECHAT_APP_ID=wxReplaceAppId123456
WECHAT_ENCODING_AES_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
PUBLIC_BASE_URL=https://replace-me.trycloudflare.com
WEBHOOK_HMAC_KEY=replace-with-at-least-32-random-characters
# Required only after pairing, when WECHAT_MODE=run.
WECHAT_ALLOWED_SENDER_HMAC=
MY_WIKI_REPO=/absolute/path/to/my-wiki
PORT=8787
CODEX_BIN=/absolute/path/to/codex
WECHAT_DNS_SERVER=1.1.1.1
